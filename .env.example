# vLLM Serving Lab - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
#
# ⚠️ WARNING: NEVER commit your actual .env file with real keys or tokens to Git!

# ── 1. Authentication & Security ──────────────────────────
# Hugging Face Token (Required for gated models or private checkpoints)
HF_TOKEN=your_huggingface_token_here

# vLLM Server API Key (Enforces bearer token authentication on endpoints when set)
# Leave empty or unset if running in a trusted local lab environment without auth.
VLLM_API_KEY=

# ── 2. Model & Engine Configuration ───────────────────────
# Default HuggingFace model repository ID (FP8 quantized for high throughput on 16GB VRAM)
VLLM_MODEL=RedHatAI/Qwen2.5-7B-Instruct-FP8-dynamic

# Served model name in OpenAI-compatible /v1/chat/completions API
VLLM_SERVED_MODEL=qwen2.5-7b-instruct-fp8

# Model weight data precision (auto, bfloat16, float16)
VLLM_DTYPE=auto

# GPU Memory Utilization (0.85 = reserve 85% of VRAM for weights + KV cache pool)
GPU_MEMORY_UTILIZATION=0.85

# Maximum sequence context length in tokens
MAX_MODEL_LEN=4096

# Maximum concurrent decoding sequences
MAX_NUM_SEQS=8

# ── 3. Advanced Optimization Flags ────────────────────────
# Prefix caching toggle (--enable-prefix-caching or --no-enable-prefix-caching)
PREFIX_CACHING_FLAG=--enable-prefix-caching

# Chunked prefill token budget per iteration step
MAX_BATCHED_TOKENS=4096

# Scheduling policy (fcfs = First-Come-First-Served, priority = Priority-based scheduling)
SCHEDULING_POLICY=fcfs

# ── 4. Networking & Ports ─────────────────────────────────
VLLM_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ── 5. Grafana ────────────────────────────────────────────
# Admin password for Grafana web UI (default: admin)
GRAFANA_PASSWORD=admin
